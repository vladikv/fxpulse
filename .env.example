# Copy to .env and adjust. Never commit .env.
# Format: KEY=value, one per line. No quotes, no "export", no backslashes: `.\mvnw spring-boot:run` reads this
# file as a Java .properties file, where quotes stay part of the value and backslashes are escape characters.

# PostgreSQL container (docker-compose.yml)
POSTGRES_DB=fxpulse
POSTGRES_USER=fxpulse
POSTGRES_PASSWORD=fxpulse
DB_PORT=25432

# Backend datasource (application.yml)
DB_URL=jdbc:postgresql://localhost:25432/fxpulse
DB_USERNAME=fxpulse
DB_PASSWORD=fxpulse

# Google Gemini API key (Phase 4) - get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Secret for POST /api/admin/ingest (send it as header X-Admin-Token). Empty = admin API disabled.
# Locally any value works; in the cloud use a long random value (Render generates one).
ADMIN_TOKEN=change-me-local
